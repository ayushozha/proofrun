# Copy to .env and fill locally. Never commit .env or send keys in chat.
PORT=8787

# Four required sponsor services. The model is intentionally chosen here.
GUILD_API_KEY=
GUILD_WORKSPACE=
GUILD_AGENT_ID=
AKASHML_API_KEY=
AKASHML_MODEL=
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
SENSO_API_KEY=
# Set from `npm run senso:seed` after creating a Senso API key.
SENSO_POLICY_CONTENT_ID=

# HackerOne researcher API credentials, separate from your browser session.
HACKERONE_API_USERNAME=
HACKERONE_API_TOKEN=
# Set true only after your HackerOne profile shows ID verification approved.
HACKERONE_ID_VERIFIED=false

# Two researcher-owned Vercel accounts; use a project owned by the first account.
VERCEL_PROJECT_ID=
# Optional for a team-owned project; keep the same team ID for both accounts.
VERCEL_TEAM_ID=
VERCEL_OWNER_TOKEN=
VERCEL_OTHER_TOKEN=
